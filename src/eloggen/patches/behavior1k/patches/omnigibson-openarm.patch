+    def debug_start_state(self, emb_sel=None, initial_joint_pos=None):
+        """
+        Print detailed diagnostics of the current start state before planning:
+          - bound_violation: joints outside CuRobo internal limits (pre-clamp)
+          - post-clamp: what value will actually be sent to the planner
+        Self/env collision info is reported by CuRobo planner itself.
+        """
+        if emb_sel is None:
+            for k in self.mg:
+                if k != CuRoboEmbodimentSelection.DEFAULT:
+                    emb_sel = k
+                    break
+            if emb_sel is None:
+                emb_sel = CuRoboEmbodimentSelection.DEFAULT
+
+        mg = self.mg[emb_sel]
+        q_phys = (self.robot.get_joint_positions() if initial_joint_pos is None else initial_joint_pos).clone()
+
+        print("[DEBUG_START] ── bound_violation (physics values vs CuRobo limits) ──")
+        try:
+            jl = mg.kinematics.kinematics_config.joint_limits
+            lo = jl.position[0].cpu()
+            hi = jl.position[1].cpu()
+            phys_map = dict(zip(self.robot_joint_names, q_phys.cpu().tolist()))
+            _eps = 1e-6
+
+            violations = []
+            for i, jname in enumerate(jl.joint_names):
+                if jname not in phys_map:
+                    continue
+                val = phys_map[jname]
+                lo_v, hi_v = lo[i].item(), hi[i].item()
+                if val < lo_v:
+                    violations.append((jname, val, "lower", lo_v, lo_v - val,
+                                       max(val, lo_v + _eps)))
+                elif val > hi_v:
+                    violations.append((jname, val, "upper", hi_v, val - hi_v,
+                                       min(val, hi_v - _eps)))
+
+            if violations:
+                for jname, val, side, limit, excess, clamped in violations:
+                    print(f"  {jname}: q={val:.8f} > {side}={limit:.8f} by {excess:.2e}  → clamp to {clamped:.8f}")
+            else:
+                print("  (none)")
+        except Exception as e:
+            print(f"  ERROR: {e}")
+
+    def _get_robot_kinematics_scale(self, device=None, dtype=None):
+        """
+        Return OG robot scale as a 3-vector when CuRobo kinematics need correction.
+
+        CuRobo builds kinematics from the unscaled robot asset. If an OG robot is
+        spawned with a non-unit scale, world targets converted into robot-local
+        coordinates need to be divided by that scale before planning. Joint values
+        and orientations are unchanged.
+        """
+        robot_scale = getattr(self.robot, "scale", None)
+        if robot_scale is None:
+            return None
+
+        scale = th.as_tensor(robot_scale, device=device, dtype=dtype).reshape(-1)
+        if scale.numel() == 1:
+            scale = scale.repeat(3)
+        scale = scale[:3]
+
+        if th.allclose(scale, th.ones_like(scale)):
+            return None
+        return scale
+
+    def debug_openarm_source_joint_target(self, src_action, target_pos, target_quat, emb_sel, label="source_action"):
+        """
+        Diagnose whether an OpenArm source joint command reaches the requested CuRobo target.
+
+        This is intentionally read-only. It compares:
+          - source joint command vs CuRobo active joint limits
+          - CuRobo FK at that source joint command vs the target pose used for IK
+          - current OG FK after temporarily applying the same source joint command
+        """
+        print(f"[IK_DIAG][OPENARM] ── source joint FK check: {label} ──")
+        try:
+            if not hasattr(self.robot, "arm_control_idx"):
+                print("  skipped: robot has no arm_control_idx")
+                return
+
+            src_action = th.as_tensor(src_action, dtype=th.float32)
+            if src_action.numel() < 15:
+                print(f"  skipped: expected >=15D OpenArm action, got shape={tuple(src_action.shape)}")
+                return
+
+            q_full = self.robot.get_joint_positions().clone()
+            q_full[self.robot.arm_control_idx["left"]] = src_action[:7].to(q_full.device, dtype=q_full.dtype)
+            q_full[self.robot.arm_control_idx["right"]] = src_action[8:15].to(q_full.device, dtype=q_full.dtype)
+
+            mg = self.mg[emb_sel]
+            jl = mg.kinematics.kinematics_config.joint_limits
+            q_map = dict(zip(self.robot_joint_names, q_full.detach().cpu().tolist()))
+            limit_violations = []
+            for i, jname in enumerate(jl.joint_names):
+                if jname not in q_map:
+                    continue
+                val = q_map[jname]
+                lo = jl.position[0][i].item()
+                hi = jl.position[1][i].item()
+                if val < lo or val > hi:
+                    limit_violations.append((jname, val, lo, hi))
+            if limit_violations:
+                print("  source joints outside CuRobo limits:")
+                for jname, val, lo, hi in limit_violations:
+                    print(f"    {jname}: q={val:.6f}, limit=[{lo:.6f}, {hi:.6f}]")
+            else:
+                print("  source joints within CuRobo active limits")
+
+            cu_js = lazy.curobo.types.state.JointState(
+                position=self._tensor_args.to_device(q_full.unsqueeze(0)),
+                joint_names=self.robot_joint_names,
+            )
+            self.update_locked_joints(cu_js, emb_sel)
+            cu_js_ordered = cu_js.get_ordered_joint_state(mg.kinematics.joint_names)
+            robot_state = mg.kinematics.compute_kinematics(cu_js_ordered)
+
+            for link_name, tgt_pos in target_pos.items():
+                if link_name not in robot_state.link_poses:
+                    available = sorted(robot_state.link_poses.keys())
+                    print(f"  {link_name}: missing in CuRobo FK link_poses; available={available}")
+                    continue
+
+                fk_pose = robot_state.link_poses[link_name]
+                fk_pos = fk_pose.position[0].detach().cpu()
+                # CuRobo stores quaternions as wxyz; ElogGen generation runtime / OG use xyzw.
+                fk_quat = fk_pose.quaternion[0][[1, 2, 3, 0]].detach().cpu()
+                tgt_pos_0_world = th.as_tensor(
+                    tgt_pos[0] if getattr(tgt_pos, "dim", lambda: 1)() > 1 else tgt_pos
+                ).detach().cpu()
+                tgt_quat = target_quat[link_name]
+                tgt_quat_0_world = th.as_tensor(
+                    tgt_quat[0] if getattr(tgt_quat, "dim", lambda: 1)() > 1 else tgt_quat
+                ).detach().cpu()
+
+                base_pos, base_quat = self.robot.links[self.base_link[emb_sel]].get_position_orientation()
+                tgt_pose_world = T.pose2mat((tgt_pos_0_world, tgt_quat_0_world))
+                tgt_pose_local = T.pose_inv(T.pose2mat((base_pos, base_quat))) @ tgt_pose_world
+                tgt_pos_0 = tgt_pose_local[:3, 3].detach().cpu()
+                tgt_quat_0 = T.mat2quat(tgt_pose_local[:3, :3]).detach().cpu()
+                robot_scale = self._get_robot_kinematics_scale(device=tgt_pos_0.device, dtype=tgt_pos_0.dtype)
+                if robot_scale is not None:
+                    tgt_pos_0 = tgt_pos_0 / robot_scale.detach().cpu()
+                    print(
+                        "  applying CuRobo kinematics scale correction: "
+                        f"local target / {robot_scale.detach().cpu().tolist()}"
+                    )
+
+                pos_err = th.linalg.norm(fk_pos - tgt_pos_0).item()
+                rot_err = T.get_orientation_diff_in_radian(fk_quat, tgt_quat_0).item()
+                print(
+                    f"  CuRobo FK {link_name}: pos={fk_pos.tolist()}, quat={fk_quat.tolist()}, "
+                    f"target_local_pos={tgt_pos_0.tolist()}, target_local_quat={tgt_quat_0.tolist()}, "
+                    f"pos_err={pos_err:.6f}, rot_err={rot_err:.6f}"
+                )
+
+            q_before = self.robot.get_joint_positions().clone()
+            try:
+                self.robot.set_joint_positions(q_full)
+                og.sim.step()
+                for link_name in target_pos.keys():
+                    if link_name not in self.robot.links:
+                        continue
+                    og_pos, og_quat = self.robot.links[link_name].get_position_orientation()
+                    tgt_pos = target_pos[link_name]
+                    tgt_quat = target_quat[link_name]
+                    tgt_pos_0 = th.as_tensor(tgt_pos[0] if getattr(tgt_pos, "dim", lambda: 1)() > 1 else tgt_pos).detach().cpu()
+                    tgt_quat_0 = th.as_tensor(tgt_quat[0] if getattr(tgt_quat, "dim", lambda: 1)() > 1 else tgt_quat).detach().cpu()
+                    og_pos = th.as_tensor(og_pos).detach().cpu()
+                    og_quat = th.as_tensor(og_quat).detach().cpu()
+                    pos_err = th.linalg.norm(og_pos - tgt_pos_0).item()
+                    rot_err = T.get_orientation_diff_in_radian(og_quat, tgt_quat_0).item()
+                    print(
+                        f"  OG FK {link_name}: pos={og_pos.tolist()}, quat={og_quat.tolist()}, "
+                        f"target_pos={tgt_pos_0.tolist()}, target_quat={tgt_quat_0.tolist()}, "
+                        f"pos_err={pos_err:.6f}, rot_err={rot_err:.6f}"
+                    )
+            finally:
+                self.robot.set_joint_positions(q_before)
+                og.sim.step()
+        except Exception as e:
+            print(f"  [IK_DIAG][OPENARM] source joint FK check failed: {e}")
 
