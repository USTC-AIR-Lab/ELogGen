(define (problem openarm_real_exp_1-0)
    (:domain omnigibson)

    (:objects
        sack.n.01_1 - sack.n.01
        checkout.n.03_1 - checkout.n.03
        apple.n.01_1 - apple.n.01
        lemon.n.01_1 - lemon.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (ontop sack.n.01_1 checkout.n.03_1)
        (ontop apple.n.01_1 checkout.n.03_1)
        (ontop lemon.n.01_1 checkout.n.03_1)
        (inroom checkout.n.03_1 grocery_store_0)
        (inroom floor.n.01_1 grocery_store_0)
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (inside apple.n.01_1 sack.n.01_1)
            (inside lemon.n.01_1 sack.n.01_1)
        )
    )
)
