(define (problem openarm_drawer_storage-0)
    (:domain omnigibson)

    (:objects
        agent.n.01_1 - agent.n.01
        toy_dice.n.01_1 - toy_dice.n.01
        alarm_clock.n.01_1 - alarm_clock.n.01
        cabinet.n.01_1 - cabinet.n.01
        checkout.n.03_1 - checkout.n.03
        floor.n.01_1 - floor.n.01
    )

    (:init
        (ontop agent.n.01_1 floor.n.01_1)
        (ontop toy_dice.n.01_1 checkout.n.03_1)
        (ontop alarm_clock.n.01_1 checkout.n.03_1)
        (ontop cabinet.n.01_1 checkout.n.03_1)
        (inroom cabinet.n.01_1 grocery_store_0)
        (inroom checkout.n.03_1 grocery_store_0)
        (inroom floor.n.01_1 grocery_store_0)
        (not (open cabinet.n.01_1))
    )

    (:goal
        (and
            (inside toy_dice.n.01_1 cabinet.n.01_1)
            (inside alarm_clock.n.01_1 cabinet.n.01_1)
            (open cabinet.n.01_1)
        )
    )
)
